{
  "final_record_schema": "result_schema.json",
  "notes": [
    "These are artifact-shape requirements, not target answers.",
    "Use evidence from the supplied task materials and record assumptions.",
    "Keep consequential actions reversible when requester intent is unknown."
  ],
  "required_files": [
    "results/final.json",
    "results/master.csv",
    "results/summary.md",
    "results/conflicts.json",
    "results/conflict_review.csv"
  ],
  "schema_version": "1.0",
  "structured_artifacts": [
    {
      "format": "csv",
      "minimum_rows": 8000,
      "path": "results/master.csv",
      "required_columns": [
        "order_id",
        "customer_id",
        "sku",
        "quantity",
        "revenue_usd",
        "order_date"
      ]
    },
    {
      "column": "order_id",
      "constraint": "unique_column",
      "path": "results/master.csv"
    }
  ]
}
