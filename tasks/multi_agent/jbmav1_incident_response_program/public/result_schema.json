{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["status", "workers", "integration", "decision"],
  "properties": {
    "status": {"enum": ["completed", "completed_with_assumption"]},
    "workers": {"type": "object", "required": ["postmortems", "control_lab", "delivery"]},
    "integration": {"type": "object", "required": ["root_cause_families", "candidate_initiatives", "funded_actions"]},
    "decision": {"type": "object", "required": ["choice", "options_considered", "question_for_requester", "assumption", "reversible_until"]}
  }
}
