# Generic OpenAI-compatible endpoint. Never commit a populated copy.
JARVISBENCH_API_BASE=https://example.invalid/v1
JARVISBENCH_API_KEY=
# Container deployments can mount a 0400 file instead of storing a secret in
# Docker Config.Env. Leave the direct value empty when using this path.
JARVISBENCH_API_KEY_FILE=
# May point to the same secret as JARVISBENCH_API_KEY, but is kept separate so
# participant and reference-controller credentials can be isolated.
JARVISBENCH_WORKER_API_KEY=
# The MAS OpenClaw adapter writes this path as a file-backed SecretRef; it never
# copies the resolved value into openclaw.json or generated model catalogs.
JARVISBENCH_WORKER_API_KEY_FILE=
JARVISBENCH_WORKER_MODEL=provider/worker-model
JARVISBENCH_JARVIS_MODEL=provider/jarvis-model
JARVISBENCH_USER_MODEL=provider/user-model
