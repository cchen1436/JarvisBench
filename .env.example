# Jarvis and Luna use OpenAI's official SDK and Responses API only. Never
# commit a populated copy.
OPENAI_API_KEY=
# A container may mount a 0400 file instead of putting the OpenAI key in
# Docker Config.Env. Leave OPENAI_API_KEY empty when using this path.
OPENAI_API_KEY_FILE=

# OpenClaw invokes the worker through its native provider stack. The default
# reference worker uses Anthropic; change both the model and key variable name
# when selecting another native OpenClaw provider.
ANTHROPIC_API_KEY=
JARVISBENCH_WORKER_API_KEY_ENV=ANTHROPIC_API_KEY
# The runner reads this 0400 file into the vendor environment only for the
# OpenClaw subprocess. It is never written to openclaw.json or manifests.
JARVISBENCH_WORKER_API_KEY_FILE=
JARVISBENCH_WORKER_MODEL=anthropic/claude-opus-4-8
JARVISBENCH_JARVIS_MODEL=gpt-5.6-sol
JARVISBENCH_USER_MODEL=gpt-5.6-luna
