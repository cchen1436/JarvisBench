{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvisbench.invalid/schema/task.public.v1.json",
  "title": "JarvisBench participant-visible task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "title",
    "domain",
    "summary",
    "source",
    "runtime",
    "episode",
    "baseline",
    "assets"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "title": {"type": "string"},
    "domain": {"type": "string"},
    "summary": {"type": "string"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adaptation", "benchmark", "license", "revision", "task_id", "url"],
      "properties": {
        "adaptation": {"type": "string"},
        "benchmark": {"type": "string"},
        "license": {"type": "string"},
        "revision": {"type": "string"},
        "task_id": {"type": "string"},
        "url": {"type": "string", "format": "uri"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpus", "family", "memory_gb", "modalities", "worker_timeout_seconds"],
      "properties": {
        "cpus": {"type": "integer", "minimum": 1},
        "family": {"type": "string"},
        "memory_gb": {"type": "integer", "minimum": 1},
        "modalities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "worker_timeout_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brief", "result_paths"],
      "properties": {
        "brief": {"type": "string"},
        "result_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^results/"}
        },
        "worker_count": {"type": "integer", "minimum": 1}
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "on_question", "user_availability"],
      "properties": {
        "model": {"type": "string"},
        "on_question": {"type": "string"},
        "user_availability": {"type": "string"}
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public"],
      "properties": {
        "public": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^public/"}
        }
      }
    }
  }
}

